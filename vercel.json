{
  "buildCommand": "pnpm build",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kessleru.com.br"
        }
      ],
      "destination": "https://kessleru.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portfolio-kessleru.vercel.app"
        }
      ],
      "destination": "https://kessleru.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/minicurso-ci",
      "destination": "https://kessleru-minicurso-ci.vercel.app/"
    },
    {
      "source": "/minicurso-ci/:path*",
      "destination": "https://kessleru-minicurso-ci.vercel.app/:path*"
    },
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/training",
      "destination": "/training/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    }
  ],
  "headers": [
    {
      "source": "/minicurso-ci(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
